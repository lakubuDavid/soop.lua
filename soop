#!/usr/bin/env lua

-- Resolve bundled dependencies relative to the launcher, not the caller's cwd.
-- This allows `soop` to be run from inside a project directory.
local SCRIPT_DIR = arg[0]:match("^(.*/)") or "./"
package.path = SCRIPT_DIR .. "?.lua;" .. SCRIPT_DIR .. "?/init.lua;" .. package.path

local VERSION_MAJOR = ""
local VERSION_MINOR =  ""
local VERSION_PATCH = ""

local VERSION = string.format("v%s.%s.%s",VERSION_MAJOR,VERSION_MINOR,VERSION_PATCH)

local argparse = require "libs.argparse"
local common = require "common"
local completion = require "completion"
local VERSION = require "version"

local function shell_quote(s)
  return "'" .. s:gsub("'", "'\\''") .. "'"
end

local function color(code, message)
  if _G.SOOP_NO_COLOR then return message end
  return string.char(27) .. "[" .. code .. "m" .. message .. string.char(27) .. "[0m"
end

-- Directory containing templates. Prefer the explicit environment variable,
-- then a local checkout's templates/ directory, and finally the installed
-- user template directory.
local CWD = os.getenv("PWD") or "."
local HOME = os.getenv("HOME") or ""
local function directory_exists(path)
  local probe = io.popen("test -d " .. shell_quote(path) .. " && printf yes")
  if not probe then return false end
  local result = probe:read("*a")
  probe:close()
  return result == "yes"
end
local local_templates = CWD .. "/templates"
local installed_templates = HOME ~= "" and (HOME .. "/.soop/templates") or ""
local config_candidates = {}
local config_override = os.getenv("SOOP_CONFIG_FILE")
if config_override then config_candidates[#config_candidates + 1] = config_override end
if HOME ~= "" then
  local xdg = os.getenv("XDG_CONFIG_HOME") or (HOME .. "/.config")
  config_candidates[#config_candidates + 1] = xdg .. "/soop/config.lua"
  config_candidates[#config_candidates + 1] = HOME .. "/.soop/config.lua"
end

local CONFIG = {}
for _, config_path in ipairs(config_candidates) do
  local file = io.open(config_path, "r")
  if file then
    file:close()
    local chunk, load_error = loadfile(config_path)
    if not chunk then error("Unable to load config " .. config_path .. ": " .. load_error) end
    local ok, value = pcall(chunk)
    if not ok then error("Unable to evaluate config " .. config_path .. ": " .. value) end
    if type(value) ~= "table" then error("Config must return a table: " .. config_path) end
    CONFIG = value
    break
  end
end

local TEMPLATES_DIR = os.getenv("SOOP_TEMPLATES_DIR") or CONFIG.templates_dir
if not TEMPLATES_DIR then
  if directory_exists(local_templates) then
    TEMPLATES_DIR = local_templates
  else
    TEMPLATES_DIR = installed_templates ~= "" and installed_templates or local_templates
  end
end
local _env_no_color = os.getenv("NO_COLOR")
local NO_COLOR =
    _env_no_color ~= nil and (_env_no_color == 1 or _env_no_color == "1")
    or CONFIG.no_color == true
_G.SOOP_NO_COLOR = NO_COLOR

local function dry_run_message(action)
  print(color("36", "[dry-run] " .. action))
end

local function list_templates()
  local command = "find " .. shell_quote(TEMPLATES_DIR) .. " -mindepth 1 -maxdepth 1 -type d -print 2>/dev/null | sort"
  local pipe = io.popen(command)
  if not pipe then
    io.stderr:write("Unable to read templates directory: " .. TEMPLATES_DIR .. "\n")
    return
  end

  local rows = {}
  for path in pipe:lines() do
    local name = path:match("([^/]+)$")
    local manifest_path = path .. "/manifest.lua"
    local file = io.open(manifest_path, "r")
    if file then
      local source = file:read("*all")
      file:close()
      -- Read only the literal description field. Listing must not execute a
      -- manifest, since manifests are executable Lua programs.
      local summary = source:match("summary%s*=%s*['\"]([^'\"]*)['\"]")
      local description = source:match("description%s*=%s*['\"]([^'\"]*)['\"]")
      rows[#rows + 1] = { name = name, summary = summary or "(no summary)", description = description or "(no description)" }
    end
  end
  pipe:close()

  if #rows == 0 then
    print("No templates found in " .. TEMPLATES_DIR)
    return
  end

  local name_width = #"NAME"
  for _, row in ipairs(rows) do
    if #row.name > name_width then name_width = #row.name end
  end

  print(color("1;36", string.format("%-" .. name_width .. "s  %s", "NAME", "SUMMARY")))
  print(color("90", string.rep("-", name_width) .. "  " .. string.rep("-", 48)))
  for _, row in ipairs(rows) do
    print(string.format("%-" .. name_width .. "s  %s", row.name, row.summary))
  end
end

local function complete_template_names()
  local command = "find " .. shell_quote(TEMPLATES_DIR) .. " -mindepth 1 -maxdepth 1 -type d -print 2>/dev/null | sort"
  local pipe = io.popen(command)
  if not pipe then return end

  for path in pipe:lines() do
    local name = path:match("([^/]+)$")
    local manifest = io.open(path .. "/manifest.lua", "r")
    if manifest then
      manifest:close()
      print(name)
    end
  end
  pipe:close()
end

local function template_details(template_name)
  local path = TEMPLATES_DIR .. "/" .. template_name
  local manifest_path = path .. "/manifest.lua"
  local file = io.open(manifest_path, "r")
  if not file then
    log_error("Template not found: " .. template_name)
    return false
  end

  local source = file:read("*all")
  file:close()
  local summary = source:match("summary%s*=%s*['\"]([^'\"]*)['\"]") or "(no summary)"
  local description = source:match("description%s*=%s*['\"]([^'\"]*)['\"]") or "(no description)"

  print("Name:        " .. template_name)
  print("Summary:     " .. summary)
  print("Description: " .. description)
  print(color("90", "Path:        " .. path))
  return true
end

local function log_info(message)
  io.stderr:write(color("36", "info") .. "  " .. message .. "\n")
end

local function log_warn(message)
  io.stderr:write(color("33", "warn") .. "  " .. message .. "\n")
end

local function log_error(message)
  io.stderr:write(color("31", "error") .. "  " .. message .. "\n")
end

local function control(kind, reason, code)
  error({ __soop_control = true, kind = kind, reason = reason or kind, code = code or 1 }, 0)
end

local collect_variables

local function setup_manifest_tooling(manifest, context)
  if not context.mise_enabled or not manifest.tooling then return true end
  if not context.destination or context.destination == "" then
    error("Manifest tooling requires a project destination", 0)
  end
  context:mkdir(context.destination)
  if not context:setup_mise(context.destination, manifest.tooling) then
    error("mise tooling setup failed", 0)
  end
  return true
end

---@class Context
---@field prompt fun(self:Context, message:string, default?:string):string
---@field info fun(self:Context, message:string):void
---@field warn fun(self:Context, message:string):void
---@field error fun(self:Context, message:string):void
---@field cancel fun(self:Context, reason?:string):never
---@field stop fun(self:Context, reason?:string):never
---@field exit fun(self:Context, code?:number, reason?:string):never
---@field rollback fun(self:Context, reason?:string):never
---@field setup_mise fun(self:Context, destination:string, tools:string|string[]):boolean
---@field run_child fun(self:Context, manifest_path:string):void
local ctx = {
  dry_run = false,
  template_dir = nil,
  ---@param self Context
  ---@param cmd string | table<string>
  ---@param opts? {run_in_dry_run?:boolean, skip_mise?:boolean}
  exec = function(self, cmd, opts)
    local _cmd = ""
    if type(cmd) == "table" then
      for _, part in ipairs(cmd) do
        _cmd = _cmd .. " " .. part
      end
    else
      _cmd = cmd
    end

    _cmd = _cmd:gsub("^%s+", "")
    local command_uses_mise = _cmd:match("^mise[%s]") or _cmd:match("[%s;&|]mise[%s]")
    local uses_mise = self.mise_enabled
      and not (opts and opts.skip_mise)
      and not command_uses_mise
    if uses_mise and self.destination and self.destination ~= "" then
      -- Run from the generated project so mise resolves its local config.
      -- Commands commonly already begin with `cd <destination> &&`; remove
      -- that prefix before wrapping them to avoid changing directories twice.
      local prefix = "cd " .. self.destination .. " && "
      local project_cmd = _cmd
      if project_cmd:sub(1, #prefix) == prefix then
        project_cmd = project_cmd:sub(#prefix + 1)
      end
      _cmd = "mise x -C " .. shell_quote(self.destination) .. " -- sh -c " .. shell_quote(project_cmd)
    end

    if self.dry_run and not (opts and opts.run_in_dry_run) then
      dry_run_message("exec  " .. _cmd)
      return true
    end

    local ok, how, code = os.execute(_cmd)
    if how == "exit" then
      return code == 0
    end
    return ok == true or ok == 0
  end,

  ---@param self Context
  ---@param path string
  mkdir = function(self, path)
    if self.dry_run then
      dry_run_message("mkdir -p " .. path)
      return true
    end
    return os.execute("mkdir -p " .. path)
  end,

  ---@param self Context
  ---@param message string
  ---@param default? string
  prompt = function(self, message, default)
    default = default or ""
    if self.dry_run then
      dry_run_message("prompt " .. message .. " [default=" .. default .. "]")
      return default
    end
    io.write(message .. " [" .. default .. "]: ")
    local value = io.read()
    if value == nil or value == "" then return default end
    return value
  end,

  info = function(self, message) log_info(message) end,
  warn = function(self, message) log_warn(message) end,
  error = function(self, message) log_error(message) end,
  cancel = function(self, reason) control("cancel", reason, 130) end,
  stop = function(self, reason) control("stop", reason, 0) end,
  exit = function(self, code, reason) control("exit", reason, code or 1) end,
  rollback = function(self, reason) control("rollback", reason, 1) end,

  setup_mise = function(self, destination, tools)
    if not self.mise_enabled then return true end
    local requested = type(tools) == "table" and tools or { tools }
    for _, tool in ipairs(requested) do
      local variable_name = tool:match("^%${([%w_]+)}$")
      local resolved = variable_name and self.vars[variable_name] or tool
      if not resolved or resolved == "" then
        error("Missing tooling variable: " .. tostring(variable_name or tool), 0)
      end
      if not self:exec({ "cd", destination, "&&", "mise", "use", resolved .. "@latest" }, { skip_mise = true }) then
        return false
      end
    end
    return true
  end,

  run_child = function(self, manifest_path)
    if self.is_child or self.depth >= 1 then
      error("Nested manifests are limited to one child level", 0)
    end

    local child_path = self.template_dir .. "/" .. manifest_path
    local file = io.open(child_path, "r")
    if not file then error("Child manifest not found: " .. manifest_path, 0) end
    file:close()

    local manifest = dofile(child_path)
    if type(manifest) ~= "table" or type(manifest.scaffold) ~= "function" then
      error("Child manifest missing scaffold function: " .. manifest_path, 0)
    end

    local child_dir = child_path:match("^(.+)/[^/]+$") or self.template_dir
    local child_vars = {}
    local definitions = manifest.variables or {}
    for _, variable in ipairs(definitions) do
      local value
      if variable.inherit then
        value = self.vars[variable.name]
      elseif variable.options then
        if self.dry_run then
          dry_run_message("child prompt " .. variable.name .. " [default=" .. tostring(variable.default or "") .. "]")
          value = variable.default
        else
          print("\n" .. variable.prompt)
          for i, option in ipairs(variable.options) do
            print(string.format("  %d) %s", i, option))
          end
          io.write("Select [1-" .. #variable.options .. "]: ")
          local choice = tonumber(io.read())
          if choice and choice >= 1 and choice <= #variable.options then
            value = variable.options[choice]
          else
            value = variable.default
          end
        end
      elseif variable.prompt then
        if self.dry_run then
          dry_run_message("child prompt " .. variable.name .. " [default=" .. tostring(variable.default or "") .. "]")
          value = variable.default
        else
          io.write(variable.prompt .. " [" .. (variable.default or "") .. "]: ")
          value = io.read()
          if value == nil or value == "" then value = variable.default end
        end
      else
        value = variable.default
      end

      if variable.validate and value ~= nil and not variable.validate(value) then
        error("Invalid child value for " .. variable.name, 0)
      end
      child_vars[variable.name] = value
    end

    local parent_view = { depth = self.depth or 0, is_child = self.is_child == true, vars = {} }
    for name, value in pairs(self.vars) do parent_view.vars[name] = value end

    local child = setmetatable({
      dry_run = self.dry_run,
      template_dir = child_dir,
      destination = self.destination,
      vars = child_vars,
      is_child = true,
      depth = (self.depth or 0) + 1,
      parent = parent_view,
    }, { __index = self })

    child.prompt = function()
      error("Child manifests must declare prompted variables in manifest.variables", 0)
    end
    child.run_child = function()
      error("Nested manifests are limited to one child level", 0)
    end

    local ok, err = pcall(function()
      setup_manifest_tooling(manifest, child)
      manifest.scaffold(child)
    end)
    if not ok then
      if manifest.cleanup then
        local cleanup_ok, cleanup_err = pcall(function() manifest.cleanup(child) end)
        if not cleanup_ok then
          log_error("Child cleanup failed: " .. tostring(cleanup_err))
        end
      end
      error(err, 0)
    end
  end,

  ---@param self Context
  ---@param src string
  ---@param dest string
  copy_file = function(self, src, dest)
    if self.dry_run then
      dry_run_message("copy " .. src .. " -> " .. dest)
      return true
    end

    local input = io.open(src, "rb")
    if not input then error("Cannot open file: " .. src) end
    local content = input:read("*all")
    input:close()

    local destdir = dest:match("^(.*/)[^/]*$")
    if destdir then
      self:mkdir(destdir)
    end

    local output = io.open(dest, "wb")
    if not output then error("Cannot write file: " .. dest) end
    output:write(content)
    output:close()
  end,

  ---@param self Context
  ---@param src string
  ---@param dest string
  ---@param vars? table
  --
  -- Recursively copies a directory tree. Every text file is rendered with the
  -- collected variables before being written:
  --   @@NAME@@   substituted with the value, empty string when unknown
  --   ${NAME}    substituted with the value, left literal when unknown
  --   ${{NAME:filter}} filtered interpolation (safe_name, lower, upper)
  -- Useful for scaffolding a whole project from a static tree.
  scaffold_dir = function(self, src, dest, vars)
    local _vars = vars or self.vars
    local src_norm = src:gsub("/+$", "")
    local dest_norm = dest:gsub("/+$", "")

    local f = io.popen("find " .. shell_quote(src_norm) .. " -type f -print 2>/dev/null")
    if not f then error("Cannot list directory: " .. src) end
    local listing = f:read("*a")
    f:close()


    for file in listing:gmatch("[^\n]+") do
      if file ~= "" then
        local rel = file:sub(#src_norm + 1)
        if rel:sub(1, 1) == "/" then rel = rel:sub(2) end
        local out = dest_norm .. "/" .. rel

        if self.dry_run then
          dry_run_message("scaffold " .. rel)
        else
          local input = io.open(file, "rb")
          if not input then error("Cannot open file: " .. file) end
          local content = input:read("*a")
          input:close()

          local rendered = common.template_string(content, _vars)
          local destdir = out:match("^(.*/)[^/]*$")
          if destdir then
            self:mkdir(destdir)
          end
          local output = io.open(out, "wb")
          if not output then error("Cannot write file: " .. out) end
          output:write(rendered)
          output:close()
        end
      end
    end
  end,

  ---@param self Context
  ---@param src string
  ---@param dest string
  copy_dir = function(self, src, dest)
    return self:exec({ "cp", "-r", src, dest })
  end,

  ---@param self Context
  ---@param src string
  ---@param dest string
  ---@param vars? table
  copy_template = function(self, src, dest, vars)
    local _vars = vars or self.vars

    local input = io.open(src, "r")
    if not input then error("Cannot open template: " .. src) end
    local content = input:read("*all")
    input:close()

    local rendered = common.template_string(content, _vars, { strict = true })

    if self.dry_run then
      dry_run_message("render " .. src .. " -> " .. dest)
      return true
    end

    local destdir = dest:match("^(.*/)[^/]*$")
    if destdir then
      self:mkdir(destdir)
    end

    local output = io.open(dest, "w")
    if not output then error("Cannot write file: " .. dest) end
    output:write(rendered)
    output:close()
  end,

  vars = {},
  is_child = false,
  depth = 0,
  parent = nil,
  destination = nil,
  mise_enabled = false
}

---@class ManifestVariable
---@field name string
---@field prompt? string
---@field default? string
---@field options? string[]
---@field validate? fun(val:string):boolean
---@field inherits? boolean

---@class Manifest
---@field scaffold fun(ctx:Context)
---@field cleanup? fun(ctx:Context)
---@field tooling? string[]  -- tool names or explicit ${VARIABLE} references
---@field variables ManifestVariable[]

---@param variables ManifestVariable[]
collect_variables = function(variables)
  local collected = {}

  for _, var in ipairs(variables) do
    local value

    if var.options then
      print("\n" .. var.prompt)
      for i, opt in ipairs(var.options) do
        print(string.format("  %d) %s", i, opt))
      end

      io.write("Select [1-" .. #var.options .. "]: ")
      local choice = tonumber(io.read())

      if choice and choice >= 1 and choice <= #var.options then
        value = var.options[choice]
      else
        value = var.default
      end
    else
      io.write(var.prompt .. " [" .. var.default .. "]: ")
      value = io.read()
      if value == "" then
        value = var.default
      end
    end

    if var.validate and not var.validate(value) then
      log_error(string.format("Invalid value for %s", var.name))
      os.exit(1)
    end

    collected[var.name] = value
  end

  return collected
end

function main()
  ---@type Parser
  local parser = argparse()
      :name "soop"
      :description "A simple project scaffolder"

  ---@diagnostic disable-next-line: undefined-field
  parser:command_target("command")

  parser
      :flag "--dry-run"
  parser
      :flag "--version"
  parser
      :flag "--mise"
  parser
      :flag "--no-color"
  parser
      :option "--templates-dir <path>"

  parser
      :command "new n"
      :argument "template-name"
  parser
      :command "create"
  parser
      :command "list ls"
  parser
      :command "details d"
      :argument "template-name"
  parser
      :command "completion"
      :argument "shell"
  parser
      :command "__complete"
      :argument "kind"

  ---@type {command: "new" | "create" | "list" | "details", template_name?: string, [string]: any}
  for _, argument in ipairs(arg) do
    if argument == "--version" or argument == "-V" then
      print("soop " .. VERSION)
      return
    end
  end
  local args = parser:parse()

  if args.version then
    print("soop " .. VERSION)
    os.exit(0)
  end

  if not args.command then
    parser:print_help()
    os.exit(0)
  end

  if args["templates-dir"] then
    TEMPLATES_DIR = args["templates-dir"]
  end
  if args.no_color then
    NO_COLOR = true
    _G.SOOP_NO_COLOR = true
  end

  if args.command == "new" or args.command == "n" then
    local template_name = args.template_name or args["template-name"]
    if not template_name then
      log_error("template-name is required")
      os.exit(1)
    end

    local mpath = TEMPLATES_DIR .. "/" .. template_name .. "/manifest.lua"

    local f = io.open(mpath, "r")
    if not f then
      log_error(string.format("Template not found: %s", template_name))
      os.exit(1)
    end
    f:close()

    ---@type Manifest
    local manifest = dofile(mpath)

    if not manifest.scaffold then
      log_error("Manifest missing scaffold function")
      os.exit(1)
    end

    -- Collect variables from manifest
    if manifest.variables and #manifest.variables > 0 then
      ctx.vars = collect_variables(manifest.variables)
    end
    ctx.dry_run = args.dry_run == true
    local mise_env = os.getenv("SOOP_MISE") or os.getenv("SOOP_ADD_MISE")
    local mise_config = CONFIG.mise == true or CONFIG.add_mise == true
    ctx.mise_enabled = args.mise == true
      or mise_config
      or mise_env == "1"
      or mise_env == "true"
      or mise_env == "yes"

    ctx.template_dir = TEMPLATES_DIR .. "/" .. template_name
    ctx.destination = ctx.vars.PROJECT_NAME
    ctx.is_child = false
    ctx.depth = 0
    ctx.parent = nil

    -- Execute scaffold. Cleanup is best-effort and only runs after the
    -- scaffold has started, so a manifest can remove partial output.
    ctx._scaffold_started = true
    local ok, err = pcall(function()
      setup_manifest_tooling(manifest, ctx)
      manifest.scaffold(ctx)
    end)

    if ok then
      log_info("Project scaffolded successfully")
    else
      local reason = err
      local code = 1
      local kind = "error"
      if type(err) == "table" and err.__soop_control then
        reason = err.reason
        code = err.code
        kind = err.kind
      end

      if manifest.cleanup and ctx._scaffold_started then
        local cleanup_ok, cleanup_err = pcall(function()
          manifest.cleanup(ctx)
        end)
        if not cleanup_ok then
          log_error("Cleanup failed: " .. tostring(cleanup_err))
        end
      end

      if kind == "stop" then
        log_warn(tostring(reason))
      elseif kind == "cancel" then
        log_warn("Cancelled: " .. tostring(reason))
      else
        log_error("Scaffold failed: " .. tostring(reason))
      end
      os.exit(code)
    end
  elseif args.command == "list" or args.command == "ls" then
    list_templates()
  elseif args.command == "__complete" then
    local kind = args.kind or args["kind"]
    if kind == "templates" then
      complete_template_names()
    else
      log_error("Unknown completion target: " .. tostring(kind))
      os.exit(1)
    end
  elseif args.command == "completion" then
    local shell = args.shell
    local generator = completion[shell]
    if not generator then
      log_error("Unsupported shell: " .. tostring(shell) .. " (expected bash, zsh, or fish)")
      os.exit(1)
    end
    io.write(generator("soop"))
  elseif args.command == "details" or args.command == "d" then
    local template_name = args.template_name or args["template-name"]
    if not template_name then
      log_error("template-name is required")
      os.exit(1)
    end
    if not template_details(template_name) then os.exit(1) end
  elseif args.command == "create" then
    -- Create a new template structure
    io.stderr:write("[TODO] Create command not implemented\n")
  end
end

main()
