#!/usr/bin/env lua

-- Resolve bundled dependencies relative to the launcher, not the caller's cwd.
-- This allows `soop` to be run from inside a project directory.
local SCRIPT_DIR = arg[0]:match("^(.*/)") or "./"
package.path = SCRIPT_DIR .. "?.lua;" .. SCRIPT_DIR .. "?/init.lua;" .. package.path

local argparse = require "libs.argparse"

-- Directory containing templates. Prefer the explicit environment variable,
-- otherwise use the current working directory's templates/ directory.
local CWD = os.getenv("PWD") or "."
local TEMPLATES_DIR = os.getenv("SOOP_TEMPLATES_DIR") or (CWD .. "/templates")
local _env_no_color = os.getenv("NO_COLOR")
local NO_COLOR =
    _env_no_color ~= nil
    and (_env_no_color == 1 or _env_no_color == "1")
    or false

local function dry_run_message(action)
  print("[dry-run] " .. action)
end

local function shell_quote(s)
  return "'" .. s:gsub("'", "'\\''") .. "'"
end

local function color(code, message)
  if NO_COLOR then return message end
  return string.char(27) .. "[" .. code .. "m" .. message .. string.char(27) .. "[0m"
end

local function log_info(message)
  io.stderr:write(color("36", "info") .. "  " .. message .. "\n")
end

local function log_warn(message)
  io.stderr:write(color("33", "warn") .. "  " .. message .. "\n")
end

local function log_error(message)
  io.stderr:write(color("31", "error") .. "  " .. message .. "\n")
end

local function control(kind, reason, code)
  error({ __soop_control = true, kind = kind, reason = reason or kind, code = code or 1 }, 0)
end

local collect_variables

---@class Context
---@field prompt fun(self:Context, message:string, default?:string):string
---@field info fun(self:Context, message:string):void
---@field warn fun(self:Context, message:string):void
---@field error fun(self:Context, message:string):void
---@field cancel fun(self:Context, reason?:string):never
---@field stop fun(self:Context, reason?:string):never
---@field exit fun(self:Context, code?:number, reason?:string):never
---@field rollback fun(self:Context, reason?:string):never
---@field run_child fun(self:Context, manifest_path:string):void
local ctx = {
  dry_run = false,
  template_dir = nil,
  ---@param self Context
  ---@param cmd string | table<string>
  ---@param opts? {run_in_dry_run?:boolean}
  exec = function(self, cmd, opts)
    local _cmd = ""
    if type(cmd) == "table" then
      for _, part in ipairs(cmd) do
        _cmd = _cmd .. " " .. part
      end
    else
      _cmd = cmd
    end

    if self.dry_run and not (opts and opts.run_in_dry_run) then
      dry_run_message("exec " .. _cmd)
      return true
    end

    local ok, how, code = os.execute(_cmd)
    if how == "exit" then
      return code == 0
    end
    return ok == true or ok == 0
  end,

  ---@param self Context
  ---@param path string
  mkdir = function(self, path)
    if self.dry_run then
      dry_run_message("mkdir -p " .. path)
      return true
    end
    return os.execute("mkdir -p " .. path)
  end,

  ---@param self Context
  ---@param message string
  ---@param default? string
  prompt = function(self, message, default)
    default = default or ""
    if self.dry_run then
      dry_run_message("prompt " .. message .. " [default=" .. default .. "]")
      return default
    end
    io.write(message .. " [" .. default .. "]: ")
    local value = io.read()
    if value == nil or value == "" then return default end
    return value
  end,

  info = function(self, message) log_info(message) end,
  warn = function(self, message) log_warn(message) end,
  error = function(self, message) log_error(message) end,
  cancel = function(self, reason) control("cancel", reason, 130) end,
  stop = function(self, reason) control("stop", reason, 0) end,
  exit = function(self, code, reason) control("exit", reason, code or 1) end,
  rollback = function(self, reason) control("rollback", reason, 1) end,

  run_child = function(self, manifest_path)
    if self.is_child or self.depth >= 1 then
      error("Nested manifests are limited to one child level", 0)
    end

    local child_path = self.template_dir .. "/" .. manifest_path
    local file = io.open(child_path, "r")
    if not file then error("Child manifest not found: " .. manifest_path, 0) end
    file:close()

    local manifest = dofile(child_path)
    if type(manifest) ~= "table" or type(manifest.scaffold) ~= "function" then
      error("Child manifest missing scaffold function: " .. manifest_path, 0)
    end

    local child_dir = child_path:match("^(.+)/[^/]+$") or self.template_dir
    local child_vars = {}
    local definitions = manifest.variables or {}
    for _, variable in ipairs(definitions) do
      local value
      if variable.inherit then
        value = self.vars[variable.name]
      elseif variable.options then
        if self.dry_run then
          dry_run_message("child prompt " .. variable.name .. " [default=" .. tostring(variable.default or "") .. "]")
          value = variable.default
        else
          print("\n" .. variable.prompt)
          for i, option in ipairs(variable.options) do
            print(string.format("  %d) %s", i, option))
          end
          io.write("Select [1-" .. #variable.options .. "]: ")
          local choice = tonumber(io.read())
          if choice and choice >= 1 and choice <= #variable.options then
            value = variable.options[choice]
          else
            value = variable.default
          end
        end
      elseif variable.prompt then
        if self.dry_run then
          dry_run_message("child prompt " .. variable.name .. " [default=" .. tostring(variable.default or "") .. "]")
          value = variable.default
        else
          io.write(variable.prompt .. " [" .. (variable.default or "") .. "]: ")
          value = io.read()
          if value == nil or value == "" then value = variable.default end
        end
      else
        value = variable.default
      end

      if variable.validate and value ~= nil and not variable.validate(value) then
        error("Invalid child value for " .. variable.name, 0)
      end
      child_vars[variable.name] = value
    end

    local parent_view = { depth = self.depth or 0, is_child = self.is_child == true, vars = {} }
    for name, value in pairs(self.vars) do parent_view.vars[name] = value end

    local child = setmetatable({
      dry_run = self.dry_run,
      template_dir = child_dir,
      destination = self.destination,
      vars = child_vars,
      is_child = true,
      depth = (self.depth or 0) + 1,
      parent = parent_view,
    }, { __index = self })

    child.prompt = function()
      error("Child manifests must declare prompted variables in manifest.variables", 0)
    end
    child.run_child = function()
      error("Nested manifests are limited to one child level", 0)
    end

    local ok, err = pcall(function() manifest.scaffold(child) end)
    if not ok then
      if manifest.cleanup then
        local cleanup_ok, cleanup_err = pcall(function() manifest.cleanup(child) end)
        if not cleanup_ok then
          log_error("Child cleanup failed: " .. tostring(cleanup_err))
        end
      end
      error(err, 0)
    end
  end,

  ---@param self Context
  ---@param src string
  ---@param dest string
  copy_file = function(self, src, dest)
    if self.dry_run then
      dry_run_message("copy " .. src .. " -> " .. dest)
      return true
    end

    local input = io.open(src, "rb")
    if not input then error("Cannot open file: " .. src) end
    local content = input:read("*all")
    input:close()

    local destdir = dest:match("^(.*/)[^/]*$")
    if destdir then
      self:mkdir(destdir)
    end

    local output = io.open(dest, "wb")
    if not output then error("Cannot write file: " .. dest) end
    output:write(content)
    output:close()
  end,

  ---@param self Context
  ---@param src string
  ---@param dest string
  ---@param vars? table
  --
  -- Recursively copies a directory tree. Every text file is rendered with the
  -- collected variables before being written:
  --   @@NAME@@   substituted with the value, empty string when unknown
  --   ${NAME}    substituted with the value, left literal when unknown
  -- Useful for scaffolding a whole project from a static tree.
  scaffold_dir = function(self, src, dest, vars)
    local _vars = vars or self.vars
    local src_norm = src:gsub("/+$", "")
    local dest_norm = dest:gsub("/+$", "")

    local f = io.popen("find " .. shell_quote(src_norm) .. " -type f -print 2>/dev/null")
    if not f then error("Cannot list directory: " .. src) end
    local listing = f:read("*a")
    f:close()

    local function render(content)
      -- A backslash escapes either token form so generated shell/JS templates
      -- can retain runtime interpolation (for example, \${DATABASE}).
      local escaped = {}
      local marker = string.char(1)
      local function protect(token)
        escaped[#escaped + 1] = token
        return marker .. tostring(#escaped) .. marker
      end

      content = content:gsub("\\(%$%{[%w_]+%})", protect)
      content = content:gsub("\\(@@[%w_]+@@)", protect)

      content = content:gsub("@@([%w_]+)@@", function(name)
        local val = _vars[name]
        if val ~= nil then return tostring(val) end
        return ""
      end)
      content = content:gsub("%$%{([%w_]+)%}", function(name)
        local val = _vars[name]
        if val ~= nil then return tostring(val) end
        return "${" .. name .. "}"
      end)

      content = content:gsub(marker .. "(%d+)" .. marker, function(index)
        return escaped[tonumber(index)]
      end)
      return content
    end

    for file in listing:gmatch("[^\n]+") do
      if file ~= "" then
        local rel = file:sub(#src_norm + 1)
        if rel:sub(1, 1) == "/" then rel = rel:sub(2) end
        local out = dest_norm .. "/" .. rel

        if self.dry_run then
          dry_run_message("scaffold " .. rel)
        else
          local input = io.open(file, "rb")
          if not input then error("Cannot open file: " .. file) end
          local content = input:read("*a")
          input:close()

          local rendered = render(content)
          local destdir = out:match("^(.*/)[^/]*$")
          if destdir then
            self:mkdir(destdir)
          end
          local output = io.open(out, "wb")
          if not output then error("Cannot write file: " .. out) end
          output:write(rendered)
          output:close()
        end
      end
    end
  end,

  ---@param self Context
  ---@param src string
  ---@param dest string
  copy_dir = function(self, src, dest)
    return self:exec({ "cp", "-r", src, dest })
  end,

  ---@param self Context
  ---@param src string
  ---@param dest string
  ---@param vars? table
  copy_template = function(self, src, dest, vars)
    local _vars = vars or self.vars

    local input = io.open(src, "r")
    if not input then error("Cannot open template: " .. src) end
    local content = input:read("*all")
    input:close()

    local rendered = content:gsub("%$%{([%w_]+)%}", function(varname)
      local val = _vars[varname]
      if not val then
        error("Template variable not found: " .. varname)
      end
      return tostring(val)
    end)

    if self.dry_run then
      dry_run_message("render " .. src .. " -> " .. dest)
      return true
    end

    local destdir = dest:match("^(.*/)[^/]*$")
    if destdir then
      self:mkdir(destdir)
    end

    local output = io.open(dest, "w")
    if not output then error("Cannot write file: " .. dest) end
    output:write(rendered)
    output:close()
  end,

  vars = {},
  is_child = false,
  depth = 0,
  parent = nil,
  destination = nil
}

---@class ManifestVariable
---@field name string
---@field prompt string
---@field default string
---@field options? string[]
---@field validate? fun(val:string):boolean
---@field inherits? boolean

---@class Manifest
---@field scaffold fun(ctx:Context):void
---@field cleanup? fun(ctx:Context):void
---@field variables ManifestVariable[]

---@param variables ManifestVariable[]
collect_variables = function(variables)
  local collected = {}

  for _, var in ipairs(variables) do
    local value

    if var.options then
      print("\n" .. var.prompt)
      for i, opt in ipairs(var.options) do
        print(string.format("  %d) %s", i, opt))
      end

      io.write("Select [1-" .. #var.options .. "]: ")
      local choice = tonumber(io.read())

      if choice and choice >= 1 and choice <= #var.options then
        value = var.options[choice]
      else
        value = var.default
      end
    else
      io.write(var.prompt .. " [" .. var.default .. "]: ")
      value = io.read()
      if value == "" then
        value = var.default
      end
    end

    if var.validate and not var.validate(value) then
      log_error(string.format("Invalid value for %s", var.name))
      os.exit(1)
    end

    collected[var.name] = value
  end

  return collected
end

function main()
  ---@type Parser
  local parser = argparse()
      :name "soop"
      :description "A simple project scaffolder"

  ---@diagnostic disable-next-line: undefined-field
  parser:command_target("command")

  parser
      :flag "--dry-run"
  parser
      :flag "--no-color"

  parser
      :command "new n"
      :argument "template-name"
  parser
      :command "create"
  parser
      :command "list ls"

  ---@type {command: "new" | "create" | "list", template_name?: string, [string]: any}
  local args = parser:parse()

  if not args.command then
    parser:print_help()
    os.exit(0)
  end

  if args.command == "new" or args.command == "n" then
    local template_name = args.template_name or args["template-name"]
    if not template_name then
      log_error("template-name is required")
      os.exit(1)
    end

    local mpath = TEMPLATES_DIR .. "/" .. template_name .. "/manifest.lua"

    local f = io.open(mpath, "r")
    if not f then
      log_error(string.format("Template not found: %s", template_name))
      os.exit(1)
    end
    f:close()

    ---@type Manifest
    local manifest = dofile(mpath)

    if not manifest.scaffold then
      log_error("Manifest missing scaffold function")
      os.exit(1)
    end

    -- Collect variables from manifest
    if manifest.variables and #manifest.variables > 0 then
      ctx.vars = collect_variables(manifest.variables)
    end
    ctx.dry_run = args.dry_run == true
    NO_COLOR = args.no_color

    ctx.template_dir = TEMPLATES_DIR .. "/" .. template_name
    ctx.destination = ctx.vars.PROJECT_NAME
    ctx.is_child = false
    ctx.depth = 0
    ctx.parent = nil

    -- Execute scaffold. Cleanup is best-effort and only runs after the
    -- scaffold has started, so a manifest can remove partial output.
    ctx._scaffold_started = true
    local ok, err = pcall(function()
      manifest.scaffold(ctx)
    end)

    if ok then
      log_info("Project scaffolded successfully")
    else
      local reason = err
      local code = 1
      local kind = "error"
      if type(err) == "table" and err.__soop_control then
        reason = err.reason
        code = err.code
        kind = err.kind
      end

      if manifest.cleanup and ctx._scaffold_started then
        local cleanup_ok, cleanup_err = pcall(function()
          manifest.cleanup(ctx)
        end)
        if not cleanup_ok then
          log_error("Cleanup failed: " .. tostring(cleanup_err))
        end
      end

      if kind == "stop" then
        log_warn(tostring(reason))
      elseif kind == "cancel" then
        log_warn("Cancelled: " .. tostring(reason))
      else
        log_error("Scaffold failed: " .. tostring(reason))
      end
      os.exit(code)
    end
  elseif args.command == "list" or args.command == "ls" then
    -- List available templates
    os.execute("ls -la " .. TEMPLATES_DIR)
  elseif args.command == "create" then
    -- Create a new template structure
    io.stderr:write("[TODO] Create command not implemented\n")
  end
end

main()
