# --- Database ---------------------------------------------------------------
# Driver selects which db/<driver> migrations and sqlc config are used.
DB_DRIVER=@@DATABASE@@

# PostgreSQL
DATABASE_URL=postgres://localhost:5432/app?sslmode=disable

# SQLite / libSQL (Turso-ready)
# DATABASE_URL=file:./data/app.db

# MySQL
# DATABASE_URL=mysql://user:pass@localhost:3306/app

# --- Auth -------------------------------------------------------------------
AUTH_SECRET=change-me-to-a-long-random-string
# Access token/session lifetime in hours
SESSION_TTL_HOURS=24

# --- Apps -------------------------------------------------------------------
API_URL=http://localhost:8080
DASHBOARD_URL=http://localhost:8081
PORT=8080
DASHBOARD_PORT=8081
