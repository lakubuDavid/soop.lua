package views

import (
	"@@MODULE@@/apps/dashboard/common"
	"@@MODULE@@/apps/dashboard/components"
)

type DashboardLayoutProps struct { Title string; User *common.User }

templ DashboardLayout(props DashboardLayoutProps) {
	@Layout(LayoutProps{Title: props.Title}) {
		<div class="flex min-h-screen bg-[var(--color-background)] text-[var(--color-text)]">
			@components.Sidebar(components.SidebarProps{User: props.User})
			<div class="flex min-w-0 flex-1 flex-col">
				@components.Header(components.HeaderProps{User: props.User})
				<div id="loading-spinner" class="htmx-indicator fixed right-4 top-4 z-50"><span class="i-tabler-loader-2 animate-spin text-xl"></span></div>
				<main id="content" class="flex-1 overflow-y-auto p-4 md:p-6">{ children... }</main>
			</div>
		</div>
	}
}
