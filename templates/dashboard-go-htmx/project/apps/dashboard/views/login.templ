package views

type LoginProps struct { Error string }

templ Login(props LoginProps) {
	@Layout(LayoutProps{Title: "Sign in"}) {
		<main class="grid min-h-screen place-items-center bg-[var(--color-background)] p-4">
			<form method="post" action="/login" class="card w-full max-w-sm space-y-4">
				<h1 class="text-xl font-semibold text-[var(--color-primary)]">Sign in</h1>
				if props.Error != "" { <p class="text-sm text-[var(--color-danger)]">{ props.Error }</p> }
				<label class="block text-sm">Email<input class="input-base mt-1" type="email" name="email" required/></label>
				<label class="block text-sm">Password<input class="input-base mt-1" type="password" name="password" required/></label>
				<button class="btn-primary w-full justify-center" type="submit">Sign in</button>
			</form>
		</main>
	}
}
